# FastAPI backend configuration. Copy values into your hosting provider's
# environment settings, or set them in the terminal before starting FastAPI.

# Recommended for Groq API Mode. Do not commit a real key.
GROQ_API_KEY=

# Firebase Web configuration. In Vercel, add either these names or the
# VITE_FIREBASE_* equivalents. Do not commit real values into this file.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Comma-separated sites allowed to call this FastAPI backend. In Vercel use
# your exact Vercel deployment origin, for example https://my-app.vercel.app.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Ollama location for local model chat and document embeddings. Set this to
# your Cloudflare/ngrok public URL in Vercel; never expose it in frontend code.
# Only needed when the Ollama provider is selected. API (Groq) mode never
# contacts Ollama, including for file uploads. Ollama chats index uploaded
# files with the nomic-embed-text model: run `ollama pull nomic-embed-text`.
OLLAMA_BASE_URL=http://localhost:11434
# Optional bearer token required by your tunnel/proxy (not Ollama itself).
OLLAMA_API_TOKEN=
# Seconds to wait for the Ollama tunnel to respond.
OLLAMA_TIMEOUT=120
APP_ID